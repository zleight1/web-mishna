      "chapter": 1,
      "number": 5,
      "phrases": [
        {
          "he": "חֲבִילֵי קַשׁ וַחֲבִילֵי עֵצִים וַחֲבִילֵי זְרָדִין, אֵין מְסַכְּכִין בָּהֶן.",
          "translations": {
