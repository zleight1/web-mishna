      "order": "zeraim",
      "tractate": "berakhot",
      "chapter": 1,
      "number": 1,
      "phrases": [
        {
          "he": "מֵאֵימָתַי קוֹרִין אֶת שְׁמַע בְּעַרְבִית",
          "translations": { "en": "From when does one recite Shema in the evening?" },
          "translit": "Me'eimatai korin et shema ba'arvit"
        },
        {
          "he": "מִשָּׁעָה שֶׁהַכֹּהֲנִים נִכְנָסִים לֶאֱכֹל בִּתְרוּמָתָן",
          "translations": { "en": "From when the priests enter to eat their teruma" },
          "translit": "Mishe'ah shehakohanim nichnasim le'echol biterumatan"
        },
        {
          "he": "עַד סוֹף הָאַשְׁמוּרָה הָרִאשׁוֹנָה",
          "translations": { "en": "until the end of the first watch" },
          "translit": "Ad sof ha'ashmurah harishonah"
        }
      ],
      "quiz": [
        {
          "id": "q1-1",
          "prompt": {
            "en": "Until when does Rabbi Eliezer say one may recite the evening Shema?",
            "he": "עד מתי אומר רבי אליעזר לקרות את שמע בערב?"
          },
          "choices": [
            { "en": "Until the end of the first watch", "he": "עד סוף האשמורה הראשונה" },
            { "en": "Until midnight", "he": "עד חצות" },
            { "en": "Until dawn", "he": "עד עלות השחר" }
          ],
          "answerIdx": 0,
          "explanation": {
            "en": "Rabbi Eliezer holds until the end of the first watch.",
            "he": "רבי אליעזר סובר עד סוף האשמורה הראשונה"
          }
        },
        {
          "id": "q1-2",
          "prompt": {
            "en": "What do the Sages say?",
            "he": "מה אומרים חכמים?"
          },
          "choices": [
            { "en": "Until midnight", "he": "עד חצות" },
            { "en": "Until the first watch", "he": "עד האשמורה הראשונה" },
            { "en": "Until three hours", "he": "עד שלוש שעות" }
          ],
          "answerIdx": 0
