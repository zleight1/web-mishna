    {
      "schemaVersion": 1,
      "id": "mishnah-berakhot-1-4",
      "ref": "Mishnah Berakhot 1:4",
      "heRef": "משנה ברכות א׳:ד׳",
      "order": "zeraim",
      "tractate": "berakhot",
      "chapter": 1,
      "number": 4,
      "phrases": [
        {
          "he": "בַּשַּׁחַר מְבָרֵךְ שְׁתַּיִם לְפָנֶיהָ וְאַחַת לְאַחֲרֶיהָ",
          "translations": { "en": "In the morning one recites two blessings before and one after" },
          "translit": "Bashachar mevarech shtayim lefaneyah ve'achat le'achareyah"
        },
        {
          "he": "וּבָעֶרֶב שְׁתַּיִם לְפָנֶיהָ וּשְׁתַּיִם לְאַחֲרֶיהָ",
          "translations": { "en": "and in the evening two before and two after" },
          "translit": "Uva'erev shtayim lefaneyah ushtayim le'achareyah"
        }
      ],
      "quiz": [
        {
          "id": "q4-1",
          "prompt": {
            "en": "How many blessings after Shema in the morning?",
            "he": "כמה ברכות אחר שמע בשחרית?"
          },
          "choices": [
            { "en": "One", "he": "אחת" },
            { "en": "Two", "he": "שתיים" },
            { "en": "Three", "he": "שלוש" }
          ],
          "answerIdx": 0
        }
      ],
      "source": {
