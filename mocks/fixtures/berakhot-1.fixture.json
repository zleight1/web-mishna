    {
      "schemaVersion": 1,
      "id": "mishnah-berakhot-1-3",
      "ref": "Mishnah Berakhot 1:3",
      "heRef": "משנה ברכות א׳:ג׳",
      "order": "zeraim",
      "tractate": "berakhot",
      "chapter": 1,
      "number": 3,
      "phrases": [
        {
          "he": "בֵּית שַׁמַּאי אוֹמְרִים בָּעֶרֶב כָּל אָדָם יַטּוּ וְיִקְרְאוּ",
          "translations": {
            "en": "Beit Shammai say: in the evening every person must recline and recite"
          },
          "translit": "Beit Shammai omrim ba'erev kol adam yatu veyikreu"
        },
        {
          "he": "וּבֵית הִלֵּל אוֹמְרִים כָּל אָדָם קוֹרֵא כְדַרְכּוֹ",
          "translations": { "en": "Beit Hillel say: every person recites as he is" },
          "translit": "Uveit Hillel omrim kol adam kore kedarko"
        }
      ],
      "quiz": [
        {
          "id": "q3-1",
          "prompt": {
            "en": "What does Beit Hillel hold regarding posture for Shema?",
            "he": "מה סוברים בית הלל לגבי קריאת שמע?"
          },
          "choices": [
            { "en": "Recite in any comfortable position", "he": "קורא כדרכו" },
            { "en": "Must recline in evening", "he": "חייב להטות בערב" },
            { "en": "Must stand always", "he": "חייב לעמוד תמיד" }
          ],
          "answerIdx": 0
        }
      ],
      "source": {
