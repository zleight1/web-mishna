    {
      "schemaVersion": 1,
      "id": "mishnah-berakhot-1-5",
      "ref": "Mishnah Berakhot 1:5",
      "heRef": "משנה ברכות א׳:ה׳",
      "order": "zeraim",
      "tractate": "berakhot",
      "chapter": 1,
      "number": 5,
      "phrases": [
        {
          "he": "מַזְכִּירִין יְצִיאַת מִצְרַיִם בַּלֵּילוֹת",
          "translations": { "en": "The exodus from Egypt is mentioned at night" },
          "translit": "Mazkirim yetziat mitzrayim balailot"
        },
        {
          "he": "יְמֵי חַיֶּיךָ הַיָּמִים כֹּל יְמֵי חַיֶּיךָ הַלֵּילוֹת",
          "translations": {
            "en": "The days of your life — the days; all the days of your life — the nights"
          },
          "translit": "Yemei chayecha hayamim, kol yemei chayecha halailot"
        }
      ],
      "quiz": [
        {
          "id": "q5-1",
          "prompt": {
            "en": "Who derived that Exodus is mentioned at night?",
            "he": "מי דרש שמזכירים יציאת מצרים בלילות?"
          },
          "choices": [
            { "en": "Ben Zoma", "he": "בן זומא" },
            { "en": "Rabbi Elazar ben Azarya", "he": "רבי אלעזר בן עזריה" },
            { "en": "Rabban Gamliel", "he": "רבן גמליאל" }
          ],
          "answerIdx": 0
        }
      ],
