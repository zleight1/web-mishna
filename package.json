{
  "name": "web-mishna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test --project=chromium-smoke --project=webkit-phone --grep-invert @visual",
    "test:e2e:matrix": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:content": "tsx scripts/build-content.ts",
    "fetch:sefaria": "tsx scripts/fetch-sefaria.ts",
    "refresh:phrases": "tsx scripts/refresh-phrases-from-sefaria.ts",
    "author:sukkah-ch1": "tsx scripts/author-sukkah-ch1.ts",
    "size-limit": "size-limit",
    "lhci": "lhci autorun",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.2",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.2.8"
  },
  "size-limit": [
    {
      "name": "entry",
      "path": "dist/assets/index-*.js",
      "limit": "250 KB"
    }
  ]
}
